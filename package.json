{
  "name": "nrbfit-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names client,server --prefix-colors cyan,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build:client",
    "build:client": "npm run build --workspace=client",
    "lint": "npm run lint:client",
    "lint:client": "npm run lint --workspace=client",
    "tasks": "node scripts/task-status.js",
    "tasks:sync": "node scripts/task-status.js --sync",
    "setup:namecheap": "bash scripts/setup-namecheap-remote.sh",
    "deploy:production": "npm run build && git add client/dist && (git diff --cached --quiet || git commit -m 'chore(build): update production build distribution') && git push production main",
    "test": "npm run lint:client"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
