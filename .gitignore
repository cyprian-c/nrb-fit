# Environment & Secrets (Never commit secrets to git)
node_modules/
.env
.env.*
*.local
!.env.example

# Documentation & Markdown Files (Kept locally, ignored from commits except README)
*.md
!README.md
!/README.md
/context/
/site.md
/task.md
server/docs/

# Automation, deployment, and server scripts (hidden from commit)
scripts/*
!scripts/task-status.js

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & Build Caches
node_modules/
dist-ssr/
.cache/
.vite/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel & Hosting
.vercel

# Test artifacts and debug logs
.playwright-mcp/
test-results/
coverage/
.neon
