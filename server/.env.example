# Server runtime port
PORT=5000

# Node environment: 'development' or 'production'
NODE_ENV=development

# Neon PostgreSQL connection string (pooled URL with sslmode=require)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/nrbfit?sslmode=require

# Secret string used to sign and verify session tokens (JWT)
JWT_SECRET=super_secret_session_key_replace_in_production_32chars

# Frontend client URL for CORS allowed origin
CLIENT_URL=http://localhost:5173
